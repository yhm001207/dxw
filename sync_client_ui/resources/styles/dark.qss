/* DXW Sync Client - Dark Theme (Tech Business) */

QMainWindow, QWidget {
    background-color: #141414;
    color: #F5F5F5;
    font-family: "Segoe UI Variable", "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 16px;
}

#sidebar {
    background-color: #1A1A1A;
    border-right: 2px solid #2B2B2B;
    min-width: 200px;
    max-width: 200px;
}

#sidebar #appTitle {
    font-size: 20px;
    font-weight: bold;
    color: #F5F5F5;
    padding: 24px 16px 8px 16px;
}

#sidebar #appSubtitle {
    font-size: 14px;
    color: #9CA3AF;
    padding: 0px 16px 20px 16px;
}

#navButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 12px 16px;
    margin: 2px 8px;
    text-align: left;
    color: #C9CDD4;
    font-size: 16px;
}

#navButton:hover {
    background-color: #2A2A2A;
    color: #F5F5F5;
}

#navButton:checked {
    background-color: #1A3A6B;
    color: #1677FF;
    font-weight: 600;
}

#topBar {
    background-color: #1F1F1F;
    border-bottom: 2px solid #2B2B2B;
    padding: 0 16px;
    min-height: 48px;
    max-height: 48px;
}

#topBar QLabel {
    font-size: 15px;
    color: #C9CDD4;
}

#topBar #statusLabel {
    font-weight: 600;
}

#bottomBar {
    background-color: #1F1F1F;
    border-top: 2px solid #2B2B2B;
    padding: 0 16px;
    min-height: 40px;
    max-height: 40px;
}

#bottomBar QLabel {
    font-size: 14px;
    color: #9CA3AF;
}

#statusBar {
    background-color: #141414;
    border-top: 2px solid #2B2B2B;
    padding: 0 16px;
    min-height: 32px;
    max-height: 32px;
}

#statusBar QLabel {
    font-size: 14px;
    color: #9CA3AF;
}

*[class="card"] {
    background-color: #1F1F1F;
    border: 2px solid #2B2B2B;
    border-radius: 8px;
    padding: 16px;
}

*[class="activity-item"] {
    background-color: transparent;
    border-bottom: 1px solid #252525;
}

*[class="stat-card"] {
    background-color: #1F1F1F;
    border: 2px solid #2B2B2B;
    border-radius: 8px;
    padding: 16px;
}

*[class="stat-card"]:hover {
    border-color: #1677FF;
}

QPushButton {
    border-radius: 6px;
    padding: 8px 20px;
    font-size: 16px;
    min-height: 36px;
}

QPushButton#primaryBtn {
    background-color: #1677FF !important;
    border: 2px solid #1677FF !important;
    color: #FFFFFF !important;
    font-weight: 600;
}

QPushButton#primaryBtn:hover {
    background-color: #4096FF !important;
    border-color: #4096FF !important;
}

QPushButton#primaryBtn:pressed {
    background-color: #0958D9 !important;
    border-color: #0958D9 !important;
}

QPushButton#primaryBtn:disabled {
    background-color: #1A3A6B !important;
    border-color: #1A3A6B !important;
    color: rgba(255,255,255,0.4) !important;
}

QPushButton#secondaryBtn {
    background-color: transparent;
    border: 2px solid #3A3A3A;
    color: #C9CDD4;
}

QPushButton#secondaryBtn:hover {
    background-color: #2A2A2A;
    border-color: #1677FF;
    color: #1677FF;
}

QPushButton#secondaryBtn:pressed {
    border-color: #0958D9;
    color: #0958D9;
}

QPushButton#textBtn {
    background-color: transparent;
    border: 2px solid transparent;
    color: #C9CDD4;
}

QPushButton#textBtn:hover {
    background-color: #2A2A2A;
    border-color: #3A3A3A;
    color: #1677FF;
}

QPushButton#textBtn:pressed {
    border-color: #1677FF;
}

QPushButton#dangerBtn {
    background-color: #F53F3F;
    border: none;
    color: white;
}

QPushButton#dangerBtn:hover {
    background-color: #FF6B6B;
}

QLineEdit, QSpinBox, QComboBox {
    background-color: #1F1F1F;
    border: 2px solid #2B2B2B;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 16px;
    color: #F5F5F5;
    min-height: 24px;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #1677FF;
    border-width: 2px;
}

QLineEdit:disabled, QSpinBox:disabled {
    background-color: #141414;
    color: #9CA3AF;
}

QComboBox QAbstractItemView {
    background-color: #1F1F1F;
    border: 2px solid #2B2B2B;
    selection-background-color: #1A3A6B;
    selection-color: #F5F5F5;
}

QProgressBar {
    background-color: #2B2B2B;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    font-size: 13px;
}

QProgressBar::chunk {
    background-color: #0FC6C2;
    border-radius: 3px;
}

QTreeView, QTableWidget {
    background-color: #1F1F1F;
    border: 2px solid #2B2B2B;
    border-radius: 6px;
    alternate-background-color: #1A1A1A;
    selection-background-color: #1A3A6B;
    selection-color: #F5F5F5;
    outline: none;
    color: #F5F5F5;
}

QTreeView::item, QTableWidget::item {
    padding: 6px 10px;
    min-height: 36px;
    color: #F5F5F5;
}

QTreeView::item:hover, QTableWidget::item:hover {
    background-color: #2A2A2A;
}

QHeaderView::section {
    background-color: #1A1A1A;
    border: none;
    border-bottom: 2px solid #2B2B2B;
    padding: 8px;
    font-size: 15px;
    font-weight: 600;
    color: #C9CDD4;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #3A3A3A;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #5A5A5A;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background-color: #3A3A3A;
    border-radius: 4px;
    min-width: 30px;
}

QGroupBox {
    background-color: #1F1F1F;
    border: 2px solid #2B2B2B;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px;
    padding-top: 28px;
    font-weight: 600;
    color: #F5F5F5;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 8px;
    color: #F5F5F5;
}

QCheckBox {
    spacing: 8px;
    font-size: 16px;
    color: #F5F5F5;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #2B2B2B;
    border-radius: 3px;
    background-color: #1F1F1F;
}

QCheckBox::indicator:checked {
    background-color: #1677FF;
    border-color: #1677FF;
}

QTabWidget::pane {
    border: none;
    background-color: transparent;
}

QTabBar::tab {
    padding: 8px 16px;
    font-size: 16px;
    color: #C9CDD4;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
}

QTabBar::tab:selected {
    color: #1677FF;
    border-bottom-color: #1677FF;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    color: #F5F5F5;
    border-bottom-color: #3A3A3A;
}

/* Dialog / Wizard */
QDialog {
    background-color: #1F1F1F;
    border: 2px solid #2B2B2B;
    border-radius: 10px;
}

QDialog QLabel {
    color: #F5F5F5;
    font-size: 15px;
}

QMessageBox {
    background-color: #1F1F1F;
    border: 2px solid #2B2B2B;
    border-radius: 10px;
}

QMessageBox QLabel {
    color: #F5F5F5;
    font-size: 15px;
}

QMessageBox QPushButton {
    min-width: 80px;
    min-height: 32px;
}

QWizard {
    background-color: #1F1F1F;
    border: 2px solid #2B2B2B;
    border-radius: 10px;
}

QWizard QWizardPage {
    background-color: transparent;
    padding: 8px;
}

QWizardPage QLabel {
    color: #F5F5F5;
    font-size: 15px;
}

QWizard QLabel[title="true"] {
    font-size: 20px;
    font-weight: bold;
    color: #F5F5F5;
    padding: 0px;
    margin-bottom: 2px;
}

QWizard QLabel[subTitle="true"] {
    font-size: 14px;
    color: #9CA3AF;
    padding: 0px;
    margin-bottom: 8px;
}

QWizard QFormLayout {
    spacing: 12px;
}

QWizard QFormLayout QLabel {
    font-size: 15px;
    color: #C9CDD4;
    padding: 0px;
    min-width: 80px;
}

QWizard QFormLayout QLineEdit,
QWizard QFormLayout QComboBox,
QWizard QFormLayout QSpinBox {
    min-height: 36px;
}

QWizard QComboBox QAbstractItemView {
    background-color: #1F1F1F;
    border: 2px solid #2B2B2B;
    border-radius: 6px;
    selection-background-color: #1A3A6B;
    selection-color: #F5F5F5;
    outline: none;
    padding: 4px;
}

QWizard QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 4px;
    min-height: 32px;
    color: #F5F5F5;
}

QWizard QComboBox QAbstractItemView::item:hover {
    background-color: #2A2A2A;
}

QToolTip {
    background-color: #2B2B2B;
    color: #F5F5F5;
    border: 1px solid #3A3A3A;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 14px;
}

#pageTitle {
    font-size: 24px;
    font-weight: bold;
    color: #F5F5F5;
}

#sectionTitle {
    font-size: 18px;
    font-weight: 600;
    color: #F5F5F5;
}

#breadcrumb {
    font-size: 15px;
    color: #9CA3AF;
    padding: 4px 0;
}

#fileInfo {
    font-size: 14px;
    color: #9CA3AF;
}

#taskPath {
    color: #C9CDD4;
    font-size: 15px;
}

#taskName {
    font-size: 17px;
    font-weight: 600;
    color: #F5F5F5;
}

#bottomVersion {
    font-size: 14px;
    color: #9CA3AF;
    padding: 12px;
}

#taskCard {
    background-color: #1F1F1F;
    border: 2px solid #2B2B2B;
    border-radius: 8px;
    padding: 16px;
    margin: 4px 0;
}

#taskCard:hover {
    border-color: #1677FF;
}

#taskProgress {
    margin: 8px 0;
}

#statValue {
    font-size: 32px;
    font-weight: bold;
    color: #F5F5F5;
}

#statLabel {
    font-size: 15px;
    color: #9CA3AF;
}

#activityText {
    font-size: 15px;
    color: #F5F5F5;
}

#activityDetail {
    font-size: 14px;
    color: #9CA3AF;
}

#emptyHint {
    font-size: 17px;
    color: #9CA3AF;
}

#infoIcon {
    font-size: 16px;
    color: #1677FF;
}

#taskDetail {
    font-size: 14px;
    color: #9CA3AF;
}

#taskName, #sectionTitle, #pageTitle {
    color: #F5F5F5;
}

/* Custom Title Bar */
#customTitleBar {
    background-color: #1A1A1A;
    border-bottom: 1px solid #2B2B2B;
}

#customTitleBar QLabel {
    color: #F5F5F5;
    font-size: 12px;
}

QPushButton#titleBtn {
    background-color: transparent;
    border: none;
    color: #C9CDD4;
    font-size: 13px;
    border-radius: 0px;
    min-height: 28px;
    padding: 0px;
}

QPushButton#titleBtn:hover {
    background-color: #2A2A2A;
    color: #F5F5F5;
}

QPushButton#titleBtn:last-child:hover {
    background-color: #3A1616;
    color: #F53F3F;
}

/* System tray menu */
QMenu {
    background-color: #1F1F1F;
    border: 1px solid #2B2B2B;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 32px 8px 16px;
    border-radius: 4px;
    color: #F5F5F5;
    font-size: 13px;
}

QMenu::item:selected {
    background-color: #2A2A2A;
    color: #1677FF;
}

QMenu::separator {
    height: 1px;
    background-color: #2B2B2B;
    margin: 4px 8px;
}
